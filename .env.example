# All variables are OPTIONAL for local development. The site runs with no env vars at all. See README for which features need which vars.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@example.com
LEAD_RATE_LIMIT_SALT=

# Optional -- site verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Analytics (Plausible/Umami/GA4) is NOT configured with env vars -- it's
# config. Set features.analytics and analytics.{provider,siteId,scriptUrl}
# in site.config.ts. See components/Analytics.tsx.

# Transactional email (Resend) -- welcome emails + unsubscribe links
# API key from the Resend dashboard -> API Keys; needs sending access for the
# verified domain. Optional: emails are skipped (and logged) when unset.
RESEND_API_KEY=re_xxxxxxxx
# Optional -- sender address for contact-form enquiry notifications; defaults to Resend's shared sandbox address (onboarding@resend.dev) until you verify your own domain.
RESEND_FROM=
# HMAC secret for signed unsubscribe links. Required by the unsubscribe route
# and email send. Generate once: openssl rand -hex 32
UNSUBSCRIBE_SECRET=generate-with-openssl-rand-hex-32
